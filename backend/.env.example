NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://campustrade:replace-password@127.0.0.1:55432/campustrade
APP_SECRET=replace-with-at-least-32-random-characters
ALLOWED_EMAIL_DOMAINS=itesa.edu.mx
PUBLIC_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173
SESSION_HOURS=8
TRUST_PROXY=0
# local solo para desarrollo. Producción exige s3 y HTTPS.
STORAGE_DRIVER=local
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# El envío no se activa hasta proporcionar un transporte real.
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
