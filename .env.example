# Solo para Docker local. Genera un valor aleatorio; no uses este marcador.
POSTGRES_PASSWORD=replace-with-a-random-local-password
APP_DB_PASSWORD=replace-with-a-random-local-password
APP_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=campustrade
POSTGRES_PORT=55432
CAMPUS_PORT=3000
# Opcional: demostración escolar con buzón local (no envía a ITESA).
# Ejecuta npm run mail:demo:setup para activarlo en el .env privado.
MAIL_DELIVERY_MODE=external
LOCAL_MAILBOX_URL=
MAILBOX_PORT=8025
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
